	email = 87268103+amirhhashemi@users.noreply.github.com
  
[core]
	editor = zed
  autocrlf = input
  compression = 9
  whitespace = error

[rerere]
	enabled = true
  autoUpdate = true

[branch]
  sort = -committerdate

[column]
  ui = auto

[init]
  defaultBranch = main
  
[rebase]
  autoStash = true
